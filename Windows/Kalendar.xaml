<Window x:Class="InformacniSystemKlub.Windows.Kalendar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Kalendář"
        Height="590"
        Width="900"
        FontFamily="Trebuchet MS"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- barvy -->
        <SolidColorBrush x:Key="White" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SoftBorder" Color="#EAEAEA"/>
        <SolidColorBrush x:Key="TextDark" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>

        <SolidColorBrush x:Key="Pink" Color="#C73F69"/>
        <SolidColorBrush x:Key="PinkDark" Color="#B8345C"/>

        <!-- stín -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="10" Opacity="0.18"/>
        
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#0A000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="14"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- primární button v pravém panelu -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PinkDark}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="14" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>

        <!-- den v kalendáři -->
        <Style x:Key="DayBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#11000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="12"
            CornerRadius="22"
            Background="{StaticResource White}"
            Effect="{StaticResource CardShadow}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Levá část -->
            <Grid Grid.Column="0" Margin="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header měsíce -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource IconBtn}"
                            Content="❮"
                            />

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtMesic"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDark}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Vyber den a vpravo uvidíš tréninky"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource IconBtn}"
                            Content="❯"
                            />
                </Grid>

                <!-- dny v týdnu -->
                <UniformGrid Grid.Row="2" Columns="7">
                    <TextBlock Text="Po" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Út" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock Text="St" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Čt" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Pá" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock Text="So" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ne" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                </UniformGrid>

                <!-- grid dnů -->
                <UniformGrid x:Name="UgDays"
                             Grid.Row="4"
                             Columns="7"/>
            </Grid>

            <!-- Pravá část -->
            <Border Grid.Column="1"
                    Background="{StaticResource Pink}"
                    CornerRadius="0,22,22,0">

                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Vybraný den"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource IconBtn}"
                                Background="#00FFFFFF"
                                Content="✕"
                                Foreground="White"
                                Click="BtnClose_Click"/>
                    </Grid>

                    <!-- vybraný datum -->
                    <TextBlock x:Name="TxtVybranyDen"
                               Grid.Row="2"
                               Foreground="White"
                               FontSize="16"
                               Opacity="0.95"/>


                    <Border Grid.Row="4"
                            CornerRadius="18"
                            Background="#22FFFFFF"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Tréninky"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="16"/>

                            <ListBox x:Name="LbTreninky"
                                     Grid.Row="2"
                                     Background="#00FFFFFF"
                                     BorderThickness="0"
                                     Foreground="White"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>


                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Odebrat"
                                Style="{StaticResource SecondaryBtn}"
                                Margin="0,0,10,0"/>

                        <Button Content="Přidat"
                                Style="{StaticResource PrimaryBtn}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
