<Window x:Class="InformacniSystemKlub.Windows.Kalendar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Kalendář"
        Height="760"
        Width="1280"
        MinHeight="680"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextMain}"
        Background="{DynamicResource BgApp}">

    <Window.Resources>
        <SolidColorBrush x:Key="BgApp" Color="#F6F7FB"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#EEF2F7"/>
        <SolidColorBrush x:Key="SurfaceSoft" Color="#E9EEF5"/>
        <SolidColorBrush x:Key="TextMain" Color="#0B1220"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="TextSoft" Color="#475569"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="Accent" Color="#F97316"/>
        <SolidColorBrush x:Key="AccentHover" Color="#EA580C"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#FFEDD5"/>
        <SolidColorBrush x:Key="OverlaySoft" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="CalendarOtherMonthBg" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="CalendarOtherMonthText" Color="#94A3B8"/>
        <SolidColorBrush x:Key="CalendarHasTrainingBg" Color="#FFEDD5"/>
        <SolidColorBrush x:Key="CalendarHasTrainingBorder" Color="#FDBA74"/>
        <SolidColorBrush x:Key="CalendarSelectedText" Color="#FFFFFF"/>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MesicoveTlacitkoStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HlavičkaDneStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoft}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="TlacitkoDneStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="KalendarComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="4,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>

                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 5 5 L 10 0 Z"
                                                      Fill="#7C2D12"
                                                      Width="10"
                                                      Height="6"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="#FDBA74"
                                        BorderThickness="1.5"
                                        CornerRadius="12"
                                        Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#0B1220"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#FFEDD5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FED7AA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20" Background="{DynamicResource BgApp}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.9*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource Surface}"
                CornerRadius="20"
                Padding="24"
                Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Kalendář tréninků"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMain}"/>

                    <TextBlock Text="Klikněte na den a vpravo uvidíte tréninky"
                               Margin="0,6,0,0"
                               FontSize="15"
                               Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="‹"
                            Style="{StaticResource MesicoveTlacitkoStyle}"
                            Click="BtnPredchoziMesic_Click"/>

                    <TextBlock x:Name="TxtMesicRok"
                               Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMain}"/>

                    <Button Grid.Column="2"
                            Content="›"
                            Style="{StaticResource MesicoveTlacitkoStyle}"
                            Click="BtnDalsiMesic_Click"/>
                </Grid>

                <UniformGrid Grid.Row="4" Columns="7">
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="Po" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="Út" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="St" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="Čt" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="Pá" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="So" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="Ne" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="6"
                        Background="{DynamicResource SurfaceAlt}"
                        CornerRadius="18"
                        Padding="10">
                    <UniformGrid x:Name="GridDnyKalendare"
                                 Rows="6"
                                 Columns="7"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource Accent}"
                CornerRadius="20"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Vybraný den"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock x:Name="TxtVybranyDen"
                           Grid.Row="2"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Nevybrán žádný den"/>

                <StackPanel Grid.Row="4"
                            Orientation="Vertical"
                            Margin="0,4,0,0">
                    <TextBlock Text="Tréninková skupina:"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <Border Background="#FFF7ED"
                            BorderBrush="#FDBA74"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="10,4">
                        <ComboBox x:Name="cbSkupina"
                                  Style="{StaticResource KalendarComboStyle}"
                                  SelectionChanged="cbSkupina_SelectionChanged"/>
                    </Border>
                </StackPanel>

                <Border Grid.Row="6"
                        Background="{DynamicResource OverlaySoft}"
                        CornerRadius="16"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Tréninky"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="18"/>

                        <ListBox x:Name="LbTreninky"
                                 Grid.Row="2"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface}"
                                            CornerRadius="10"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMain}"
                                                       Text="{Binding Misto}"/>

                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding Popis}"/>

                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding Prijmeni, StringFormat=Trenér: {0}}"/>

                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding NazevSkupiny, StringFormat=Skupina: {0}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>