<Window x:Class="InformacniSystemKlub.Windows.Kalendar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Kalendář"
        Height="760"
        Width="1280"
        MinHeight="680"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextMain}"
        Background="{DynamicResource BgApp}">

    <Window.Resources>
        <!-- Výchozí LIGHT MODE hodnoty -->
        <SolidColorBrush x:Key="BgApp" Color="#F6F7FB"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#EEF2F7"/>
        <SolidColorBrush x:Key="SurfaceSoft" Color="#E9EEF5"/>
        <SolidColorBrush x:Key="TextMain" Color="#0B1220"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="TextSoft" Color="#475569"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="Accent" Color="#F97316"/>
        <SolidColorBrush x:Key="AccentHover" Color="#EA580C"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#FFEDD5"/>
        <SolidColorBrush x:Key="OverlaySoft" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="CalendarOtherMonthBg" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="CalendarOtherMonthText" Color="#94A3B8"/>
        <SolidColorBrush x:Key="CalendarHasTrainingBg" Color="#FFEDD5"/>
        <SolidColorBrush x:Key="CalendarHasTrainingBorder" Color="#FDBA74"/>
        <SolidColorBrush x:Key="CalendarSelectedText" Color="#FFFFFF"/>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MesicoveTlacitkoStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HlavičkaDneStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoft}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="TlacitkoDneStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20" Background="{DynamicResource BgApp}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.9*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Levá část -->
        <Border Grid.Column="0"
                Background="{DynamicResource Surface}"
                CornerRadius="20"
                Padding="24"
                Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Kalendář tréninků"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMain}"/>

                    <TextBlock Text="Klikněte na den a vpravo uvidíte tréninky"
                               Margin="0,6,0,0"
                               FontSize="15"
                               Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="‹"
                            Style="{StaticResource MesicoveTlacitkoStyle}"
                            Click="BtnPredchoziMesic_Click"/>

                    <TextBlock x:Name="TxtMesicRok"
                               Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMain}"/>

                    <Button Grid.Column="2"
                            Content="›"
                            Style="{StaticResource MesicoveTlacitkoStyle}"
                            Click="BtnDalsiMesic_Click"/>
                </Grid>

                <UniformGrid Grid.Row="4" Columns="7">
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="Po" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="Út" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="St" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="Čt" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="Pá" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="So" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                    <Border Style="{StaticResource HlavičkaDneStyle}">
                        <TextBlock Text="Ne" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSoft}"/>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="6"
                        Background="{DynamicResource SurfaceAlt}"
                        CornerRadius="18"
                        Padding="10">
                    <UniformGrid x:Name="GridDnyKalendare"
                                 Rows="6"
                                 Columns="7"/>
                </Border>
            </Grid>
        </Border>

        <!-- Pravá část -->
        <Border Grid.Column="1"
                Background="{DynamicResource Accent}"
                CornerRadius="20"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Vybraný den"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock x:Name="TxtVybranyDen"
                           Grid.Row="2"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Nevybrán žádný den"/>

                <Border Grid.Row="4"
                        Background="{DynamicResource OverlaySoft}"
                        CornerRadius="16"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Tréninky"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="18"/>

                        <ListBox x:Name="LbTreninky"
                                 Grid.Row="2"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface}"
                                            CornerRadius="10"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMain}"
                                                       Text="{Binding Misto}"/>

                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding Popis}"/>

                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding Prijmeni, StringFormat=Trenér: {0}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <WrapPanel Grid.Row="6"
                           HorizontalAlignment="Right">
                    <Button x:Name="BtnPridat"
                            Content="Přidat"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="BtnPridat_Click"/>

                    <Button x:Name="BtnEditovat"
                            Content="Editovat"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="BtnEditovat_Click"/>

                    <Button x:Name="BtnOdebrat"
                            Content="Odebrat"
                            Margin="0"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="BtnOdebrat_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>