<Window x:Class="InformacniSystemKlub.Windows.PridejWindows.PridejNominaci"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InformacniSystemKlub.Windows.PridejWindows"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Přidání nominace"
        WindowStartupLocation="CenterScreen"
        Width="1100" Height="840"
        MinWidth="1100" MaxWidth="1100"
        MinHeight="840" MaxHeight="840"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextMain}"
        Background="{DynamicResource BgApp}">

    <Window.Resources>

        <SolidColorBrush x:Key="BgApp" Color="#F6F7FB"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMain" Color="#0B1220"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="InputBg" Color="#F8FAFC"/>

        <SolidColorBrush x:Key="Orange" Color="#F97316"/>
        <SolidColorBrush x:Key="OrangeHover" Color="#EA580C"/>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FB923C" Offset="0"/>
            <GradientStop Color="#F97316" Offset="1"/>
        </LinearGradientBrush>

        <!-- Styl popisků formuláře -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,6,10,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputHost" TargetType="Border">
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="InputHostTall" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="Spin" TargetType="{x:Type xctk:IntegerUpDown}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
        </Style>

        <!-- Styl pro zaškrtávací pole -->
        <Style x:Key="CheckTheme" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Styl ComboBoxu -->
        <Style x:Key="ComboTheme" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderSoft}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderSoft}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          OverridesDefaultStyle="True"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">

                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Margin="6,0,0,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>

                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 6 6 L 12 0 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource BorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="2">
                                    <ScrollViewer SnapsToDevicePixels="True" MaxHeight="320">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl tlačítka -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource Orange}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource OrangeHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{DynamicResource BgApp}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Levý informační panel -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarGradient}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Image Source="/Images/award.png"
                       Width="150"
                       Height="150"
                       Margin="0,0,0,24"/>

                <TextBlock Text="Přidání nominace"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           Opacity="0.95"
                           TextAlignment="Center"/>

                <TextBlock Text="Vyberte hráče a zápas."
                           FontSize="13"
                           Foreground="#FFF7ED"
                           Margin="0,10,0,0"
                           Opacity="0.95"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Pokud je zápas odehraný, zadejte statistiky hráče v tomto zápase."
                           FontSize="13"
                           Foreground="#FFF7ED"
                           Margin="0,10,0,0"
                           Opacity="0.9"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Pokud se zápas teprve bude hrát, můžete navrhnout nominaci podle zvolených kritérií."
                           FontSize="13"
                           Foreground="#FFF7ED"
                           Margin="0,10,0,0"
                           Opacity="0.9"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Pravá část obsahuje samotný vstupní formulář -->
        <Border Grid.Column="1"
                Background="{DynamicResource Surface}"
                CornerRadius="24"
                Margin="18"
                Padding="28">

            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.12"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Hráč" Style="{DynamicResource Lbl}"/>
                    <Border Grid.Row="0" Grid.Column="1" Style="{DynamicResource InputHost}">
                        <ComboBox x:Name="cbHrac"
                                  Style="{DynamicResource ComboTheme}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource TextMain}">
                                        <Run Text="{Binding Prijmeni}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Jmeno}"/>
                                        <Run Text=" | Góly: "/>
                                        <Run Text="{Binding PocetVstrelenychGolu}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Zápas" Style="{DynamicResource Lbl}"/>
                    <Border Grid.Row="1" Grid.Column="1" Style="{DynamicResource InputHost}">
                        <ComboBox x:Name="cbZapas"
                                  Style="{DynamicResource ComboTheme}"
                                  SelectionChanged="cbZapas_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource TextMain}">
                                        <Run Text="{Binding DomaciTym}"/>
                                        <Run Text=" vs "/>
                                        <Run Text="{Binding HosteTym}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Doporučení hráčů" Style="{DynamicResource Lbl}"/>
                    <Border Grid.Row="2" Grid.Column="1" Style="{DynamicResource InputHostTall}">
                        <StackPanel>
                            <CheckBox x:Name="chkJenZdravi"
                                      Content="Zobrazit jen zdravotně způsobilé hráče (A)"
                                      Style="{DynamicResource CheckTheme}"
                                      Checked="FiltrHrace_Changed"
                                      Unchecked="FiltrHrace_Changed"/>
                            <CheckBox x:Name="chkBezOpatreni"
                                      Content="Skrýt hráče s aktivním opatřením"
                                      Style="{DynamicResource CheckTheme}"
                                      Checked="FiltrHrace_Changed"
                                      Unchecked="FiltrHrace_Changed"/>
                            <CheckBox x:Name="chkJenSeGolem"
                                      Content="Hráči, kteří dali, alespoň 1 gól"
                                      Style="{DynamicResource CheckTheme}"
                                      Checked="FiltrHrace_Changed"
                                      Unchecked="FiltrHrace_Changed"/>
                            <CheckBox x:Name="chkSeraditDleStatistik"
                                      Content="Seřadit hráče podle statistik"
                                      Style="{DynamicResource CheckTheme}"
                                      Checked="FiltrHrace_Changed"
                                      Unchecked="FiltrHrace_Changed"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Stav zápasu" Style="{DynamicResource Lbl}"/>
                    <TextBox x:Name="TxtStavZapasu"
                             Grid.Row="3" Grid.Column="1"
                             Style="{DynamicResource Input}"
                             IsReadOnly="True"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Počet odehraných minut" Style="{DynamicResource Lbl}"/>
                    <Border Grid.Row="4" Grid.Column="1" Style="{DynamicResource InputHost}">
                        <xctk:IntegerUpDown x:Name="iudPocetMinut"
                                            Style="{DynamicResource Spin}"
                                            Value="0"
                                            Minimum="0"
                                            Maximum="300"/>
                    </Border>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Počet gólů" Style="{DynamicResource Lbl}"/>
                    <Border Grid.Row="5" Grid.Column="1" Style="{DynamicResource InputHost}">
                        <xctk:IntegerUpDown x:Name="iudPocetGolu"
                                            Style="{DynamicResource Spin}"
                                            Value="0"
                                            Minimum="0"
                                            Maximum="100"/>
                    </Border>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Počet žlutých karet" Style="{DynamicResource Lbl}"/>
                    <Border Grid.Row="6" Grid.Column="1" Style="{DynamicResource InputHost}">
                        <xctk:IntegerUpDown x:Name="iudPocetZlutychKaret"
                                            Style="{DynamicResource Spin}"
                                            Value="0"
                                            Minimum="0"
                                            Maximum="2"/>
                    </Border>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Počet červených karet" Style="{DynamicResource Lbl}"/>
                    <Border Grid.Row="7" Grid.Column="1" Style="{DynamicResource InputHost}">
                        <xctk:IntegerUpDown x:Name="iudPocetCervenychKaret"
                                            Style="{DynamicResource Spin}"
                                            Value="0"
                                            Minimum="0"
                                            Maximum="1"/>
                    </Border>

                    <Button Grid.Row="8" Grid.Column="1"
                            Content="Přidat"
                            Style="{DynamicResource BtnPrimary}"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0"
                            Click="BtnUlozit_Click"/>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>