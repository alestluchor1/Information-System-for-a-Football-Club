<Window x:Class="InformacniSystemKlub.Windows.NajdiWindows.NajdiHrace"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InformacniSystemKlub.Windows.NajdiWindows"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        
        Title="Filtrování hráčů"
        WindowStartupLocation="CenterScreen"
        Width="1100" Height="740"
        MinWidth="1100" MaxWidth="1100"
        MinHeight="740" MaxHeight="740"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Foreground="#0B1220"
        Background="#F6F7FB">

    <Window.Resources>

        <!-- Barvy -->
        <SolidColorBrush x:Key="BgApp" Color="#F6F7FB"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMain" Color="#0B1220"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="InputBg" Color="#F8FAFC"/>

        <!-- Oranžová -->
        <SolidColorBrush x:Key="Orange" Color="#F97316"/>
        <SolidColorBrush x:Key="OrangeHover" Color="#EA580C"/>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#000000" Offset="0"/>
            <GradientStop Color="#F97316" Offset="1"/>
        </LinearGradientBrush>

        <!-- Label vlevo -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,6,10,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>

        <!-- TextBox -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vzhled Combobox -->
        <Style x:Key="InputHost" TargetType="Border">
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <!-- Styl pro IntegerUpDown -->
        <Style x:Key="Spin" TargetType="{x:Type xctk:IntegerUpDown}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>

        <!-- Primární tlačítko -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource Orange}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource OrangeHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource BgApp}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Levý panel -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradient}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Image Source="/Images/bigPlayer.png" Width="150" Height="150" Margin="0,0,0,24"/>
                <TextBlock Text="Filtrování hráčů" FontSize="28" FontWeight="SemiBold"
                           Foreground="#FFFFFF" Opacity="0.95" TextAlignment="Center"/>
                <TextBlock Text="Vyplňte údaje o hráči" FontSize="13"
                           Foreground="#FFF7ED" Margin="0,8,0,0" Opacity="0.9" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Pravý panel -->
        <Border Grid.Column="1"
                Background="{StaticResource Surface}"
                CornerRadius="24"
                Margin="18"
                Padding="28">

            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.12"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 0 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Jméno" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtJmeno" Grid.Row="0" Grid.Column="1" MaxLength="20" Style="{StaticResource Input}"/>

                    <!-- 1 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Příjmení" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtPrijmeni" Grid.Row="1" Grid.Column="1" MaxLength="20" Style="{StaticResource Input}"/>

                    <!-- 2 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Rodné číslo" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtRodneCislo" Grid.Row="2" Grid.Column="1" MaxLength="10" Style="{StaticResource Input}"/>

                    <!-- 3 -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Telefonní číslo" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtTelefonniCislo" Grid.Row="3" Grid.Column="1" MaxLength="12" Style="{StaticResource Input}"/>

                    <!-- 4 Góly (spinner min 0) -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Počet vstřelených gólů" Style="{StaticResource Lbl}"/>
                    <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource InputHost}">
                        <xctk:IntegerUpDown x:Name="iudPocetGolu"
                                            Style="{StaticResource Spin}"
                                            Value="0"
                                            Minimum="0"
                                            Maximum="100"/>
                    </Border>

                    <!-- 5 Žluté karty -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Počet žlutých karet" Style="{StaticResource Lbl}"/>
                    <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource InputHost}">
                        <xctk:IntegerUpDown x:Name="iudPocetZlutychKaret"
                                            Style="{StaticResource Spin}"
                                            Value="0"
                                            Minimum="0"
                                            Maximum="100"/>
                    </Border>

                    <!-- 6 Červené karty -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Počet červených karet" Style="{StaticResource Lbl}"/>
                    <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource InputHost}">
                        <xctk:IntegerUpDown x:Name="iudPocetCervenychKaret"
                                            Style="{StaticResource Spin}"
                                            Value="0"
                                            Minimum="0"
                                            Maximum="100"/>
                    </Border>

                    <!-- 7 Zdravotní stav (A/N) -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Zdravotní stav" Style="{StaticResource Lbl}"/>
                    <Border Grid.Row="7" Grid.Column="1" Style="{StaticResource InputHost}">
                        <ComboBox x:Name="cbZdraviStav"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="6,0"
                                  VerticalContentAlignment="Center"
                                  Foreground="{StaticResource TextMain}"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="A"/>
                            <ComboBoxItem Content="N"/>
                        </ComboBox>
                    </Border>

                    <!-- 8 Pozice -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Pozice" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtPozice" Grid.Row="8" Grid.Column="1" MaxLength="50" Style="{StaticResource Input}"/>

                    <!-- 9 Věk (spinner min 3) -->
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Věk" Style="{StaticResource Lbl}"/>
                    <Border Grid.Row="9" Grid.Column="1" Style="{StaticResource InputHost}">
                        <xctk:IntegerUpDown x:Name="iudVek"
                                            Style="{StaticResource Spin}"
                                            Value="3"
                                            Minimum="3"
                                            Maximum="100"/>
                    </Border>

                    <!-- 10 Tlačítko -->
                    <Button Grid.Row="10" Grid.Column="1"
                            Content="Najdi"
                            Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0"
                            Click="BtnNajdi_Click"/>
                </Grid>

            </ScrollViewer>
        </Border>
    </Grid>
</Window>
