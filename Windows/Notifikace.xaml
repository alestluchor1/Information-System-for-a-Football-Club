<Window x:Class="InformacniSystemKlub.Windows.Notifikace"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Notifikace"
        WindowStartupLocation="CenterScreen"
        Width="1100" Height="740"
        MinWidth="1100" MaxWidth="1100"
        MinHeight="740" MaxHeight="740"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextMain}"
        Background="{DynamicResource BgApp}">

    <Window.Resources>

        <SolidColorBrush x:Key="BgApp" Color="#F6F7FB"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMain" Color="#0B1220"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="InputBg" Color="#F8FAFC"/>

        <SolidColorBrush x:Key="Orange" Color="#F97316"/>
        <SolidColorBrush x:Key="OrangeHover" Color="#EA580C"/>

        <!-- Gradient levého panelu -->
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FB923C" Offset="0"/>
            <GradientStop Color="#F97316" Offset="1"/>
        </LinearGradientBrush>

        <!-- Styl popisků -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,6,10,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
            <Setter Property="SelectionBrush" Value="#60FFFFFF"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MultiLineInput" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
            <Setter Property="SelectionBrush" Value="#60FFFFFF"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl seznamu příjemců -->
        <Style x:Key="ListBoxTheme" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl checkboxu v seznamu -->
        <Style x:Key="CheckBoxTheme" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Styl tlačítek -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource Orange}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource OrangeHover}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{DynamicResource BgApp}">
        <Grid.ColumnDefinitions>
            <!-- Levý informační panel -->
            <ColumnDefinition Width="320"/>
            <!-- Pravá část -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Levý panel -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarGradient}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Image Source="/Images/user.png"
                       Width="150"
                       Height="150"
                       Margin="0,0,0,24"/>

                <TextBlock Text="Notifikace"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           Opacity="0.95"
                           TextAlignment="Center"/>

                <TextBlock Text="Odešlete e-mail vybraným uživatelům"
                           FontSize="13"
                           Foreground="#FFF7ED"
                           Margin="0,8,0,0"
                           Opacity="0.9"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Pravý hlavní obsah -->
        <Border Grid.Column="1"
                Background="{DynamicResource Surface}"
                CornerRadius="24"
                Margin="18"
                Padding="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.12"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Nadpis levé části -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Příjemci"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource TextMain}"/>

                <!-- Levá část s výběrem příjemců -->
                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Popis -->
                    <TextBlock Grid.Row="0"
                               Text="Vyberte všechny nebo vyhledejte konkrétní uživatelské jméno:"
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextMain}"
                               Margin="0,0,0,6"/>

                    <!-- Vyhledávání -->
                    <TextBox x:Name="TxtHledatUzivatele"
                             Grid.Row="1"
                             Style="{DynamicResource Input}"
                             MaxLength="50"
                             TextChanged="TxtHledatUzivatele_TextChanged"/>

                    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                        <CheckBox x:Name="ChbVszichniHraci"
                                  Content="Všichni hráči"
                                  Style="{DynamicResource CheckBoxTheme}"
                                  Margin="0,0,10,6"
                                  Checked="ChbVszichniHraci_Checked"
                                  Unchecked="ChbVszichniHraci_Unchecked"/>

                        <CheckBox x:Name="ChbATym"
                                  Content="A-Tým"
                                  Style="{DynamicResource CheckBoxTheme}"
                                  Margin="0,0,10,6"
                                  Checked="ChbATym_Checked"
                                  Unchecked="ChbATym_Unchecked"/>

                        <CheckBox x:Name="ChbDorost"
                                  Content="Dorost"
                                  Style="{DynamicResource CheckBoxTheme}"
                                  Margin="0,0,10,6"
                                  Checked="ChbDorost_Checked"
                                  Unchecked="ChbDorost_Unchecked"/>

                        <CheckBox x:Name="ChbMladsiZaci"
                                  Content="Mladší žáci"
                                  Style="{DynamicResource CheckBoxTheme}"
                                  Margin="0,0,10,6"
                                  Checked="ChbMladsiZaci_Checked"
                                  Unchecked="ChbMladsiZaci_Unchecked"/>

                        <CheckBox x:Name="ChbVszichniTreneri"
                                  Content="Všichni trenéři"
                                  Style="{DynamicResource CheckBoxTheme}"
                                  Margin="0,0,10,6"
                                  Checked="ChbVszichniTreneri_Checked"
                                  Unchecked="ChbVszichniTreneri_Unchecked"/>

                        <CheckBox x:Name="ChbAdministratori"
                                  Content="Administrátoři"
                                  Style="{DynamicResource CheckBoxTheme}"
                                  Margin="0,0,10,6"
                                  Checked="ChbAdministratori_Checked"
                                  Unchecked="ChbAdministratori_Unchecked"/>
                    </WrapPanel>

                    <!-- Seznam příjemců -->
                    <ListBox x:Name="LbPrijemci"
                             Grid.Row="3"
                             Style="{DynamicResource ListBoxTheme}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding UzivatelskeJmeno}"
                                          IsChecked="{Binding JeVybran, Mode=TwoWay}"
                                          Style="{DynamicResource CheckBoxTheme}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="2">
                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Předmět"
                               Style="{DynamicResource Lbl}"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,4"/>

                    <TextBox x:Name="TxtPredmet"
                             Grid.Row="1"
                             MaxLength="100"
                             Style="{DynamicResource Input}"/>

                    <TextBlock Grid.Row="2"
                               Text="Zpráva"
                               Style="{DynamicResource Lbl}"
                               HorizontalAlignment="Left"
                               Margin="0,10,0,4"/>

                    <!-- pro text zprávy -->
                    <TextBox x:Name="TxtZprava"
                             Grid.Row="3"
                             MaxLength="2000"
                             Style="{DynamicResource MultiLineInput}"/>
                </Grid>

                <!-- Tlačítka -->
                <StackPanel Grid.Row="2" Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="Odeslat"
                            Style="{DynamicResource BtnPrimary}"
                            Click="BtnOdeslat_Click"/>

                    <Button Content="Zrušit"
                            Style="{DynamicResource BtnPrimary}"
                            Margin="10,0,0,0"
                            Click="BtnZrusit_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>